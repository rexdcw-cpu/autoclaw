# ===========================================================================
# autoclaw · 环境变量样例（部署侧复制为 .env，.env 已被 .gitignore 忽略）
# ===========================================================================

# --- 持久化后端选择（config/db.js 读取）---
# 'mysql'（默认）：连 WSL/远程 MySQL（见下方 AUTOCLAW_DB_* 变量）。
# 'sqlite'：本地免服务器测试，启动自动建表于 data/autoclaw.db，无需任何 DB 服务器。
AUTOCLAW_DB_TYPE=sqlite
# SQLite 文件路径（仅 sqlite 模式生效；留空则默认 ./data/autoclaw.db）
AUTOCLAW_SQLITE_PATH=

# --- MySQL 连接配置（切回 mysql 时填，config/db.js 读取，增量架构 §2.2）---
# 绝不硬编码；Windows 部署时 MySQL 仍跑在 WSL，经 localhost:3306 访问
AUTOCLAW_DB_HOST=localhost
AUTOCLAW_DB_PORT=3306
AUTOCLAW_DB_USER=root
AUTOCLAW_DB_PASSWORD=
AUTOCLAW_DB_NAME=autoclaw
# 连接池上限
AUTOCLAW_DB_LIMIT=10

# --- 控制台访问令牌（决策 A3）---
AUTOCLAW_TOKEN=autoclaw-dev

# --- 可见窗口（T-D5 路线拍板后启用，当前未使用，仅预留）---
# 路线 A（VNC）：置 false 启用有头浏览器（需配合 xvfb-run）
# AUTOCLAW_HEADLESS=true
# 路线 C（截图流）：置 0 关闭截图流以省开销
# AUTOCLAW_SCREENSHOT=1
