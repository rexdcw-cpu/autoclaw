# 依赖
node_modules/

# 运行日志（任务日志落盘目录，内容不入库）
logs/*.log
logs/*.log.*

# 本地数据/模板缓存
data/*.json
# 任务完成度统计报告（运行产物，不入库）
data/task-stats-*.md

# 运行时 SQLite 库（含任务日志，不入库）
data/*.db
data/*.db-*

# 浏览器持久化 profile 缓存
data/chrome-profile/
data/google-profile/

# 环境变量
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db

# Windows 保留名误生成（沙箱里 `>nul` 被当成文件重定向生成的 0 字节垃圾，删不掉）
/nul

# 临时服务器启动日志（沙箱/手动拉起时生成）
_server*.log

# 工具内部记忆/状态（非项目源码）
.workbuddy/
