# 依赖
node_modules/

# 运行日志（任务日志落盘目录，内容不入库）
logs/*.log
logs/*.log.*

# 本地数据/模板缓存
data/*.json
# 任务完成度统计报告（运行产物，不入库）
data/task-stats-*.md

# 运行时 SQLite 库（含任务日志，不入库）
data/*.db
data/*.db-*

# 浏览器持久化 profile 缓存
data/chrome-profile/
data/google-profile/

# 环境变量
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db

# Windows 保留名误生成（沙箱里 `>nul` 被当成文件重定向生成的 0 字节垃圾，删不掉）
/nul

# 临时服务器启动日志（沙箱/手动拉起时生成）
_server*.log

# 工具内部记忆/状态（非项目源码）
.workbuddy/

# ---- v0.3.60 补充 ----
# worker / 守护日志落盘（data 目录，运行产物不入库）
data/*.log

# 守护单实例锁与启动探针日志
data/guardian.lock
data/startup_*.log

# 一次性诊断 / 监控 / 校验脚本与报告（非源码）
data/_*.md
data/_*.js
data/*_report.md

# 统计产物与临时文件
data/*.tmp
data/task-completion-stats.json*.tmp

# 根目录一次性脚本 / 导出 / 日志（下划线前缀约定）
/_*.txt
/_*.py
/_*.json
/prog.json
/autoclaw.log
